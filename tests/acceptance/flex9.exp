#!/usr/bin/expect -f
#
# FLEX9 BOOTS on the SWTPC 6809 -- the MP-09, its DAT and S-BUG, and the DC-4, end to end.
# S-BUG loads the DAT from a junk power-up state, sizes the RAM and signs on; its `U` command
# restores drive 0, reads track 0 sector 1 into $C000 and jumps there; FLEX9 loads, signs on,
# asks the date, and drops to its `+++` prompt. Typing CAT and getting the directory back is
# the 6809 core, the DAT, the I/O window at E000, the WD179x read path and the FLEX filesystem
# all working at once. This is the 6809's boot gate (DESIGN.md 3.2).
#
# IT HAS TO BE AN EXPECT TEST, not a pipe: the console read is polled, so a keystroke only
# lands if the guest is sitting in its read loop, and only a tty paces bytes to the emulated
# 9600 baud. So: WAIT FOR EACH PROMPT IN FULL before sending the next line -- the trailing
# space of the date prompt is deliberate, it means the prompt finished printing.
#
# IT BOOTS THE SHIPPED EXAMPLE, once per disk: examples/flex9/ carries FLEX9 in all three DC-4
# geometries, and every disk that ships is booted by a test. CMake registers one test per
# machine file.
#
# THE DISK MUST NOT MOVE. The example mounts it write-protected; shasummed before and after.
#
# usage: expect -f flex9.exp <swtpcsim> <machine file> <disk image>
#
set timeout 60
log_user 0

set exe [lindex $argv 0]
set toml [lindex $argv 1]
set dsk [lindex $argv 2]

set before [exec shasum $dsk]

spawn $exe $toml

# S-BUG comes up on reset: it can only print 56K if the DAT, the RAM and the console are all
# where it looks for them.
expect {
    -ex "S-BUG 1.8 - 56K" {}
    eof     { puts "FAIL: the machine did not start -- see the error above"; exit 1 }
    timeout { puts "FAIL: S-BUG never signed on"; exit 1 }
}
expect {
    -ex ">" {}
    eof     { puts "FAIL: S-BUG signed on but the machine died"; exit 1 }
    timeout { puts "FAIL: S-BUG signed on but never printed its `>` prompt"; exit 1 }
}

# BOOT FLEX9. `U` is a single-letter S-BUG command -- no CR.
send "U"
expect {
    -ex "FLEX - Version 2.8:3" {}
    eof     { puts "FAIL: the machine died booting FLEX9"; exit 1 }
    timeout { puts "FAIL: FLEX9 never signed on -- the `U` boot did not load the system"; exit 1 }
}
expect {
    -ex "Date (MM,DD,YY)? " {}
    eof     { puts "FAIL: FLEX9 signed on but died before the date prompt"; exit 1 }
    timeout { puts "FAIL: FLEX9 signed on but never asked the date"; exit 1 }
}

# Answer the date; FLEX drops to its `+++` command prompt.
send "1,15,80\r"
expect {
    -ex "+++" {}
    eof     { puts "FAIL: FLEX9 died taking the date"; exit 1 }
    timeout { puts "FAIL: FLEX9 took the date but never reached its `+++` prompt"; exit 1 }
}

# CAT reads the directory off the disk -- the WD179x read path, sector by sector.
send "CAT\r"
expect {
    -ex "CATALOG OF DRIVE NUMBER 0" {}
    eof     { puts "FAIL: the machine died running CAT"; exit 1 }
    timeout { puts "FAIL: CAT produced no catalog -- the directory read failed"; exit 1 }
}
expect {
    -ex "PCPUT" {}
    eof     { puts "FAIL: CAT started the catalog but died mid-listing"; exit 1 }
    timeout { puts "FAIL: CAT never reached PCPUT, the directory's last entry"; exit 1 }
}
expect {
    -ex "SECTORS LEFT" {}
    eof     { puts "FAIL: CAT listed files but died before the free-space line"; exit 1 }
    timeout { puts "FAIL: CAT listed files but never finished (no free-space line)"; exit 1 }
}

# ...and CAT returned to the prompt.
expect {
    -ex "+++" {}
    eof     { puts "FAIL: CAT listed the directory but the console did not return to `+++`"; exit 1 }
    timeout { puts "FAIL: CAT listed the directory but never came back to `+++`"; exit 1 }
}

set after [exec shasum $dsk]
if {$before ne $after} {
    puts "FAIL: THE IMAGE CHANGED. `writeprotect` did not protect the disk:"
    puts "  before: $before"
    puts "  after:  $after"
    exit 1
}

puts "OK: $dsk -- FLEX9 booted through S-BUG's `U` to its +++ prompt, CAT listed the directory off\
      the disk, and the image is byte-identical."
exit 0
