# Build
build/
build-asan/
out/
cmake-build-*/
_deps/
CMakeUserPresets.json

# The plain-Makefile convenience build (docs/building-*.md): objects, generated
# sources and the binary all live here (kept out of build/, which is CMake's).
build-make/

# Editors / IDEs
.vscode/
.idea/
*.swp
.cache/
compile_commands.json

# macOS
.DS_Store
.AppleDouble
Icon?
._*

# Windows
Thumbs.db
